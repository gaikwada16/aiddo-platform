generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum ProviderStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum JobStatus {
  DRAFT
  OPEN
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LedgerEntryType {
  CUSTOMER_PAYMENT
  PROVIDER_EARNING
  PLATFORM_FEE
  BONUS
  BENEFIT
  REFUND
  WITHDRAWAL
  ADJUSTMENT
  TAX_DEDUCTION
  INSURANCE_CONTRIBUTION
}

enum LedgerEntryStatus {
  PENDING
  POSTED
  REVERSED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String?
  name            String
  phone           String?
  role            UserRole         @default(CUSTOMER)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  jobs            Job[]            @relation("UserJobs")
  providerProfile ProviderProfile?
  ledgerEntries   LedgerEntry[]
}

model ProviderProfile {
  id            String         @id @default(cuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String
  bio           String?
  skills        String[]       @default([])
  rating        Decimal        @default(0.00) @db.Decimal(3, 2)
  completedJobs Int            @default(0)
  isVerified    Boolean        @default(false)
  status        ProviderStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  jobs          Job[]          @relation("ProviderJobs")
}

model Job {
  id          String    @id @default(cuid())
  customerId  String
  providerId  String?
  title       String
  description String
  category    String
  price       Decimal   @db.Decimal(10, 2)
  status      JobStatus @default(OPEN)
  location    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  acceptedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  customer      User             @relation("UserJobs", fields: [customerId], references: [id], onDelete: Cascade)
  provider      ProviderProfile? @relation("ProviderJobs", fields: [providerId], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]
}

model LedgerEntry {
  id            String            @id @default(cuid())
  userId        String
  jobId         String?
  transactionId String?
  type          LedgerEntryType
  amount        Decimal           @db.Decimal(19, 2)
  currency      String            @default("INR")
  status        LedgerEntryStatus @default(PENDING)
  description   String
  metadata      Json              @default("{}")
  reversedBy    String?
  createdAt     DateTime          @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  job            Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  reversedEntry  LedgerEntry?  @relation("LedgerReversal", fields: [reversedBy], references: [id], onDelete: SetNull)
  reverseEntries LedgerEntry[] @relation("LedgerReversal")
}
